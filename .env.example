# Redis
REDIS_URL=redis://127.0.0.1:6379/
REDIS_STREAM=stream:pdf-processing
REDIS_GROUP=extraction-workers
REDIS_DLQ_STREAM=stream:pdf-processing-dlq

# Worker
WORKER_CONSUMER_NAME=
WORKER_BLOCK_MS=5000
WORKER_BATCH_COUNT=1
WORKER_JOB_TIMEOUT_SECS=300
WORKER_MIN_IDLE_MS=600001
WORKER_XAUTOCLAIM_INTERVAL_SECS=30
WORKER_MAX_ATTEMPTS=5
# Bulkhead (S2-P3-03): extracciones en paralelo por instancia
WORKER_MAX_CONCURRENCY=4
# Limite duro del PDF descargado, defensa en profundidad (S2-P3-01)
WORKER_MAX_PDF_BYTES=31457280
# Topes ante PDF hostil (seccion 11.5)
WORKER_MAX_PAGES=2000
WORKER_MAX_OUTPUT_BYTES=52428800

# Mongo con rol acotado a update sobre documents (ADR-0006).
# Para desarrollo, levantar labs/docker-compose.yml (ver labs/dev-stack.md).
MONGO_WORKER_URI=mongodb://worker:worker-dev-secret@127.0.0.1:27017/app?authSource=app&directConnection=true
MONGO_DB=app
MONGO_TIMEOUT_MS=3000

# S3/MinIO (seccion 11.4): GET raw-pdfs, PUT extracted-txt.
# Para desarrollo, levantar labs/docker-compose.yml (ver labs/dev-stack.md).
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET_RAW=raw-pdfs
S3_BUCKET_TXT=extracted-txt
S3_ACCESS_KEY=worker-dev
S3_SECRET_KEY=worker-dev-secret
# Timeout de cada operacion S3 en ms (default 60000).
S3_OP_TIMEOUT_MS=60000

# Observabilidad (DoD 3)
# JSON por defecto; LOG_FORMAT=text para desarrollo local.
RUST_LOG=info
LOG_FORMAT=json
# Periodo de refresco de gauges de cola/PEL (segundos, minimo 1).
WORKER_METRICS_INTERVAL_SECS=15
# Presupuesto para drenar jobs en vuelo al apagar (segundos, 0-5).
WORKER_SHUTDOWN_DRAIN_SECS=4

# HTTP
HTTP_PORT=8081
