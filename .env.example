# Redis
REDIS_URL=redis://127.0.0.1:6379/
REDIS_STREAM=stream:pdf-processing
REDIS_GROUP=extraction-workers
REDIS_DLQ_STREAM=stream:pdf-processing-dlq

# Worker
WORKER_CONSUMER_NAME=
WORKER_BLOCK_MS=5000
WORKER_BATCH_COUNT=1
WORKER_JOB_TIMEOUT_SECS=300
WORKER_MIN_IDLE_MS=600001
WORKER_XAUTOCLAIM_INTERVAL_SECS=30
WORKER_MAX_ATTEMPTS=5
# WORKER_MAX_CONCURRENCY=4  # pendiente (bulkhead, F3)

# HTTP
HTTP_PORT=8081
