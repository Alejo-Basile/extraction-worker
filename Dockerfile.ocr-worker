# syntax=docker/dockerfile:1
# --- Builder ---
FROM rust:1.90-bookworm AS builder
WORKDIR /src

RUN apt-get update && apt-get install -y --no-install-recommends pkg-config build-essential && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

# `target/` es un cache mount: NO queda en la capa del builder, por eso el
# binario se copia a /src, que si queda y es lo que consume el `COPY --from`.
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/src/target,sharing=locked \
    cargo build --release --locked -p ocr-worker \
    && cp /src/target/release/ocr-worker /src/ocr-worker

# --- Runtime ---
FROM debian:trixie-slim

ENV TESSDATA_PREFIX=/usr/share/tesseract-ocr/5
ENV OCR_DPI=150
ENV OCR_LIMIT_W=3500
ENV OCR_LIMIT_PIX=12000000
ENV OCR_LANG=spa+eng
ENV OCR_OEM=1
ENV OCR_PSM=3
ENV OCR_MAX_ATTEMPTS=3
ENV METRICS_ADDR=0.0.0.0:8080

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    poppler-utils \
    imagemagick \
    tesseract-ocr \
    tesseract-ocr-spa \
    tesseract-ocr-eng \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 worker \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin worker

COPY --from=builder /src/ocr-worker /usr/local/bin/ocr-worker

# S11-P1-C30: last-known-good CONFIG CACHE DIRECTORY.
# The compose service mounts `ocr-worker-config-cache` here and the rootfs is
# read_only, so the directory must exist with the runtime user as owner: an
# empty named volume inherits the image directory's ownership on first use.
RUN mkdir -p /var/lib/ocr-worker && chown 10001:10001 /var/lib/ocr-worker

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --retries=6 --start-period=15s \
    CMD curl -fsS http://127.0.0.1:8080/healthz || exit 1

USER 10001:10001
ENTRYPOINT ["ocr-worker"]
